{
  "$schema": "../schemas/layout.schema.json",
  "$comment": "Turn sections on and off (disabled) and change their order (order) per page, without editing the page files. Ids are the section ids in content/pages/<page>.json.",
  "pages": {
    "home": {
      "order": [
        "hero",
        "welcome",
        "rector-message",
        "community",
        "events-news",
        "get-involved",
        "join-orthodoxconnect"
      ],
      "disabled": []
    },
    "services": {
      "order": ["services-header", "upcoming", "recordings", "service-texts", "prayers"],
      "disabled": []
    },
    "about": {
      "order": ["about-header", "about", "history", "membership", "bylaws", "faith"],
      "disabled": []
    },
    "clergy": { "order": ["clergy-header", "rector", "clergy-list", "council"], "disabled": [] },
    "ministries": {
      "order": ["ministries-header", "choir", "sisterhood", "school", "photos", "hall"],
      "disabled": []
    },
    "news": { "order": ["news-header", "news"], "disabled": [] },
    "give": {
      "order": ["give-header", "give", "dues-stewardship", "your-gifts-at-work"],
      "disabled": []
    },
    "contact": {
      "order": ["contact-header", "office-hours", "visit", "contacts", "links"],
      "disabled": []
    },
    "not-found": { "order": ["not-found-header", "not-found-links"], "disabled": [] }
  }
}
