{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events.schema.json",
  "title": "Events",
  "description": "content/events.json: parish events (coffee hours, concerts, picnics). Past events are hidden automatically.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "An event without `date` is listed as \"date to be announced\" and never hides.",
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/editorial"
          }
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "date": {
            "$ref": "common.schema.json#/$defs/date"
          },
          "endDate": {
            "$ref": "common.schema.json#/$defs/date"
          },
          "time": {
            "$ref": "common.schema.json#/$defs/time"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "location": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "description": {
            "$ref": "common.schema.json#/$defs/markdown"
          },
          "ministry": {
            "$ref": "common.schema.json#/$defs/id",
            "description": "ministries id, used to filter event-list sections."
          },
          "link": {
            "$ref": "common.schema.json#/$defs/link"
          }
        },
        "required": [
          "id",
          "title"
        ],
        "unevaluatedProperties": false
      }
    }
  },
  "required": [
    "events"
  ],
  "additionalProperties": false
}
